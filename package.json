{
  "name": "electionsmap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TUTV election night broadcast graphics: /control, /tv, /gfx",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "dev:sim": "SIMULATE=1 npm run dev",
    "build": "vite build && tsc -p tsconfig.server.json && cp -R server/seed dist/server/seed",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "seed": "tsx scripts/build-seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.4",
    "@fontsource/inter": "^5.3.0",
    "d3-geo": "^3.1.1",
    "fastify": "^5.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
