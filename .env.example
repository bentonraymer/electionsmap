# Password for /control (required; the server will not start without it)
CONTROL_PASSWORD=
# Secret used to sign the login cookie (any long random string)
COOKIE_SECRET=
# Optional: require ?token=... on /tv and /gfx URLs
DISPLAY_TOKEN=
# Seconds between national Senate/House refreshes
POLL_INTERVAL=30
# Per-race detail requests per second to civicAPI (governors, Oklahoma, starred races)
DETAIL_RPS=1
# Seconds between refreshes of the race currently on /tv
ON_AIR_INTERVAL=15
# Rehearsal mode: 1 = fake results on real races (uses /data/sim, separate from live data)
SIMULATE=0
SIM_SPEED=1
CIVICAPI_BASE=https://civicapi.org/api/v2
